# STRIDEX Backend Environment Configuration
# Rapid Application Development (RAD) Coursework

# Server Port & Mode
PORT=3000
NODE_ENV=development

# Database URIs (Local MongoDB or MongoDB Atlas)
MONGO_LOCAL_URL=mongodb://localhost:27017/stridex_db
MONGO_ATLAS_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stridex?retryWrites=true&w=majority

# JWT Stateless Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# Cloud Object Storage (Supabase Storage)
# IMPORTANT: For backend operations, use the secret/service_role key to allow direct image uploads
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
SUPABASE_STORAGE_BUCKET=stridex-products

# AI Integration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Email Notification Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="STRIDEX Footwear" <noreply@stridex.com>
FRONTEND_URL=http://localhost:5173
